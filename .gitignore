# Python
__pycache__/
*.py[cod]

# pytest's cache. Ignored here rather than relying on the .gitignore pytest writes
# inside each cache dir: that marker is written only when the cache is first created
# and is never restored if it is removed, so the cache becomes committable. Same
# reasoning as **/.graph/ below. CONTRIBUTING tells every contributor to run pytest,
# and it leaves a cache in each directory it is run from.
**/.pytest_cache/

# macOS
.DS_Store

# Generated dependency-graph caches (regenerable; should never be committed).
# .graph/ is the shipped location (knowledge-base/.graph/); .code-graph/ is the
# pre-0.2.0 name, kept so an un-migrated clone stays clean.
**/.graph/
**/.code-graph/

# Plugin runtime marker (created when this repo is symlinked as a local-dev plugin install)
.in_use/

# Brainstorming/planning scratch. The superpowers brainstorming and writing-plans
# skills write here by hardcoded path; it is working material for whoever is at the
# keyboard, not part of the product. Decisions that come out of it belong in
# docs/decisions/ as an ADR, outstanding work in docs/backlog.md.
docs/superpowers/

# Local agent settings: contains absolute paths from whoever ran it.
# Ignored globally on the author's machine; pinned here so a fresh clone is safe too.
.claude/settings.local.json

# graphify backend output (Track B spike). Regenerable; never committed.
graphify-out/
